{
  "name": "website",
  "version": "1.4.9",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run clean && next build",
    "prod": "npm run build && npm run copy-htaccess",
    "clean": "rimraf ./out",
    "copy-htaccess": "cp .htaccess ./out/.htaccess",
    "start": "next start",
    "audit:ci": "npm audit --omit=dev --audit-level=high && node scripts/audit.mjs",
    "lint": "eslint src",
    "test": "eslint src",
    "lighthouse": "lhci autorun --config=./lighthouserc.js && kill $!"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.34.0",
    "@emotion/react": "^11.13.5",
    "@eslint/config-array": "^0.23.5",
    "@eslint/object-schema": "^3.0.4",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@mantine/carousel": "^9.7.1",
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@next/third-parties": "^16.3.8",
    "@tabler/icons-react": "^3.49.0",
    "embla-carousel-react": "^8.0.0",
    "ftp-deploy": "^2.4.7",
    "glob": "^13.0.6",
    "motion": "^12.38.0",
    "next": "^16.3.8",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intersection-observer": "^10.0.3",
    "react-spinners": "^0.17.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/node": "25.6.0",
    "@types/react": "19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "rimraf": "^6.1.3"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "postcss": ">=8.5.23 <9.0.0",
    "js-yaml": ">=5.4.1 <6.0.0",
    "nanoid": ">=3.3.18 <4.0.0",
    "uuid": ">=14.0.0 <15.0.0",
    "qs": ">=6.16.0 <7.0.0",
    "@babel/core": ">=7.29.6 <8.0.0",
    "sharp": "$sharp",
    "basic-ftp": ">=6.2.1 <7.0.0",
    "body-parser": ">=1.20.8 <2.0.0",
    "puppeteer-core": ">=25.9.0 <26.0.0",
    "ftp-deploy": {
      "minimatch": "^9.0.7"
    }
  }
}
