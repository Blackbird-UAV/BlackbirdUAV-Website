{
  "name": "website",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run clean && next build",
    "prod": "npm run build && npm run copy-htaccess",
    "clean": "rimraf ./out",
    "copy-htaccess": "node -e \"require('fs').copyFileSync('.htaccess', 'out/.htaccess')\"",
    "audit:ci": "npm audit --omit=dev --audit-level=high && node scripts/audit.mjs",
    "lint": "eslint .",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "test": "npm run lint && npm run build && npm run check:sitemap",
    "lighthouse": "lhci autorun --config=./lighthouserc.js",
    "lighthouse:live": "lhci autorun --config=./lighthouserc.js",
    "resize-images": "node scripts/resize-images.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@next/third-parties": "^16.4.0",
    "@tabler/icons-react": "^3.49.0",
    "motion": "^12.38.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "globals": "^17.13.0",
    "rimraf": "^6.1.3"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "postcss": ">=8.5.23 <9.0.0",
    "js-yaml": ">=5.4.1 <6.0.0",
    "nanoid": ">=3.3.18 <4.0.0",
    "uuid": ">=14.0.0 <15.0.0",
    "qs": ">=6.16.0 <7.0.0",
    "@babel/core": ">=7.29.6 <8.0.0",
    "sharp": "$sharp",
    "basic-ftp": ">=6.2.1 <7.0.0",
    "body-parser": ">=1.20.8 <2.0.0",
    "puppeteer-core": ">=25.9.0 <26.0.0"
  }
}
