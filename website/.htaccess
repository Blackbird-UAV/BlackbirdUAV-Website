RewriteEngine On
RewriteBase /

# Redirect old sponsorship package PDF to new one
RewriteRule ^assets/Blackbird\ UAV\ Sponsorship\ Package\ 2024-2025\.pdf$ /assets/bbuavsponsorpackage2025.pdf [R=301,L]

# Rewrite clean URLs to .html files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/?$ $1.html [L]

# Rewrite dynamic routes in the MeetTheTeam folder to [year].html
RewriteCond %{REQUEST_URI} ^/MeetTheTeam/([^/]+)/?$
RewriteCond %{DOCUMENT_ROOT}/MeetTheTeam/[year].html -f
RewriteRule ^MeetTheTeam/([^/]+)/?$ MeetTheTeam/[year].html [L]

# Serve index.html for root
DirectoryIndex index.html

# Disable directory listing so unlinked files aren't enumerable
Options -Indexes

# Security response headers
<IfModule mod_headers.c>
  # Stop browsers from MIME-sniffing a response away from its declared type
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking protection. SAMEORIGIN (not DENY) so the site can still be
  # framed by our own pages if needed.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Send the full referrer to ourselves, origin-only cross-origin, nothing on downgrade
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # No page here needs these device APIs
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>