RewriteEngine On
RewriteBase /

# Certificate validation (cPanel AutoSSL, Let's Encrypt) fetches files
# under /.well-known/ over plain HTTP, so serve them as they are: no HTTPS
# redirect, no dotfile 403. This tests the rule's decoded, normalised path,
# not %{REQUEST_URI}, which LiteSpeed can leave raw, so a request for
# /.well-known/../.ftp-deploy-sync-state.json can't skip the rules below.
RewriteRule ^\.well-known/ - [L]

# Send plain-HTTP requests to HTTPS. The port check means a request that
# came in over HTTPS can never loop, even if %{HTTPS} were misreported.
RewriteCond %{HTTPS} !=on
RewriteCond %{SERVER_PORT} ^80$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Refuse dotfiles, such as the deploy's .ftp-deploy-sync-state.json, which
# lists every deployed file with its hash
RewriteRule (^|/)\. - [F,L]

# Redirect old sponsorship package PDF to new one
RewriteRule ^assets/Blackbird\ UAV\ Sponsorship\ Package\ 2024-2025\.pdf$ /assets/bbuavsponsorpackage2025.pdf [R=301,L]

# One URL per page, the one in each page's canonical tag. THE_REQUEST is the
# request line as the browser sent it, so these two only see what was asked
# for, never the clean-URL rewrites below (matching those would loop).
# /index and /index.html are /
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index(\.html)?/?[?\s]
RewriteRule ^ / [R=301,L]

# /vehicles.html is /vehicles, /MeetTheTeam/2026-2027.html is
# /MeetTheTeam/2026-2027 (the query string is kept). Only for files that
# exist, so a miss is a plain 404. Both the path and the existence check come
# from THE_REQUEST, not from the URL being processed: for a miss like
# /nope.html, the internal request for the 404 page (/404.html) runs these
# rules too, and would otherwise be redirected to /404. Apache marks that
# request with REDIRECT_STATUS, but LiteSpeed doesn't. The /+ stops
# //vehicles.html from redirecting to //vehicles, which is another host.
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+([^?\s]+)\.html[?\s]
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^ /%1 [R=301,L]

# /MeetTheTeam is a folder with no index page (a 403 under -Indexes), so send
# it to the current season's roster. A temporary redirect, because the target
# moves every year: keep the year in step with teamLinks in
# src/components/Navbar.js.
RewriteRule ^MeetTheTeam/?$ /MeetTheTeam/2026-2027 [R=302,L]

# Rewrite clean URLs (e.g. /vehicles) to their exported page, if there is
# one. Without that check a miss such as /robots.txt was rewritten to
# robots.txt.html, then robots.txt.html.html and so on, until Apache gave up
# with a 500. /404 is left out so the 404 page is only ever served as a 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond $1 !^404$
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Rewrite nested clean URLs (e.g. /MeetTheTeam/2024-2025) to their exported
# page. Each team year is now its own .html file, so this maps to the real
# page instead of the old single [year].html template.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
RewriteRule ^([^/]+)/([^/]+?)/?$ $1/$2.html [L]

# Serve index.html for root
DirectoryIndex index.html

# Missing pages get the site's own 404 page, with its navigation, and a 404
# status. The page loads its scripts and styles from absolute /_next/ paths,
# so it works at any depth (e.g. /MeetTheTeam/1999-2000).
ErrorDocument 404 /404.html

# Disable directory listing so unlinked files aren't enumerable
Options -Indexes

# Security response headers
<IfModule mod_headers.c>
  # Stop browsers from MIME-sniffing a response away from its declared type
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking protection. SAMEORIGIN (not DENY) so the site can still be
  # framed by our own pages if needed.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Send the full referrer to ourselves, origin-only cross-origin, nothing on downgrade
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # No page here needs these device APIs
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Once a browser has seen this over HTTPS, it refuses plain HTTP for this
  # host for a year, so AutoSSL must keep renewing the certificate: if it ever
  # lapsed, visitors couldn't click past the warning. No includeSubDomains:
  # that would force HTTPS on every subdomain too, and dev.blackbirduav.ca
  # isn't on the certificate.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Caching. Everything under /_next/static is named after its content's hash
  # or sits under the build ID, so a URL there never changes content and
  # browsers can keep it for a year without asking again. FilesMatch sees only
  # the file name, not its folder: this relies on the export having no other
  # .js, .css or .woff2 files, so give any such file added to public/ a new
  # name whenever its content changes.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Pages (and the build's _next/data, robots.txt and sitemap.xml) change with
  # every deploy. no-cache lets browsers keep them but makes them check first,
  # usually a quick 304, so a deploy shows at once.
  <FilesMatch "\.(html|json|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Images, the favicon and the sponsorship PDF keep their names when they are
  # replaced, so browsers reuse them for a day only. Some photos end in .JPG.
  <FilesMatch "\.(jpe?g|JPE?G|png|PNG|gif|webp|avif|svg|ico|pdf)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>